# Rynn - Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to git. It is already listed in .gitignore.
#
# If you previously used one of the example keys that shipped in older
# versions of this file (gsk_..., nz-..., nsk_...), treat them as leaked.
# Those keys were committed to the repository. Revoke and regenerate them.

# MongoDB connection string (optional, leave empty for local storage)
MONGODB_URL=

# Naze API key (https://naze.dev). Required for API-powered features.
NAZE_API_KEY=nz-your-key-here

# Neosantara AI key (https://app.neosantara.xyz). Optional.
NEOSANTARA_API_KEY=

# Bot WhatsApp number for the pairing code (optional, format 628xx)
NUMBER_BOT=6285764173508

# Owner number(s), comma separated (optional, format 628xx,628yy)
OWNER_NUMBER=6282173282591

# Admin key for the relay dashboard. REQUIRED if DASHBOARD_ENABLED=true.
# Use a long random string. Leave empty otherwise.
ADMIN_KEY=

# Relay dashboard (connects the bot to bot.naze.biz.id and can expose a
# remote exec endpoint). Default OFF. Read the security notes in README
# before enabling.
DASHBOARD_ENABLED=false

# Must be true separately to enable the remote exec endpoint, even when
# DASHBOARD_ENABLED=true. Default OFF.
ALLOW_REMOTE_EXEC=false

# Set true only if an API you use has an invalid/self-signed certificate
# and you accept the MITM risk. Default OFF (TLS is verified).
ALLOW_INSECURE_TLS=false
