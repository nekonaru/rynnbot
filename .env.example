# Rynn - Environment Variables
# Copy file ini menjadi .env dan isi dengan nilai milikmu.
# JANGAN PERNAH commit .env ke git. File ini sudah ada di .gitignore.
#
# Jika sebelumnya kamu memakai key contoh yang dikirim di versi lama
# file ini (gsk_..., nz-..., nsk_...), anggap key tersebut bocor.
# Key itu ikut ter-commit ke repositori. Revoke dan generate ulang.

# MongoDB connection string (opsional, kosongkan untuk penyimpanan lokal)
MONGODB_URL=

# Naze API key (https://naze.dev). Wajib untuk fitur berbasis API.
NAZE_API_KEY=nz-your-key-here

# Neosantara AI key (https://app.neosantara.xyz). Opsional.
NEOSANTARA_API_KEY=

# Nomor WhatsApp bot untuk pairing code (opsional, format 628xx)
NUMBER_BOT=6285764173508

# Nomor owner, pisahkan dengan koma (opsional, format 628xx,628yy)
OWNER_NUMBER=6282173282591

# Admin key untuk relay dashboard. WAJIB diisi kalau DASHBOARD_ENABLED=true.
# Gunakan string acak yang panjang. Kosongkan selain itu.
ADMIN_KEY=

# Relay dashboard (menghubungkan bot ke bot.naze.biz.id dan bisa mengekspos
# endpoint exec jarak jauh). Default MATI. Baca catatan keamanan di README
# sebelum mengaktifkan.
DASHBOARD_ENABLED=false

# Harus true terpisah untuk mengaktifkan endpoint exec jarak jauh, walau
# DASHBOARD_ENABLED=true. Default MATI.
ALLOW_REMOTE_EXEC=false

# Set true hanya kalau API yang kamu pakai punya sertifikat invalid/self-signed
# dan kamu menerima risiko MITM. Default MATI (TLS diverifikasi).
ALLOW_INSECURE_TLS=false
