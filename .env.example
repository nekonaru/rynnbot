# MongoDB connection string
MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/rynn?appName=Cluster0

# Groq AI API Key (https://console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Keys eksternal
NAZE_API_KEY=nz-xxxxxxxxxxxx
NEOSANTARA_API_KEY=nsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
