# =========================================================
#  RynnBot — Environment Variables
#  Salin file ini menjadi .env dan isi nilainya SENDIRI.
#  JANGAN commit file .env ke Git!
#
#  ⚠️ Jika kamu sebelumnya memakai key contoh yang ada di versi lama
#  file ini (gsk_..., nz-..., nsk_...), anggap key tersebut BOCOR —
#  key itu ikut ter-commit ke repo publik. Revoke/regenerate di
#  dashboard provider masing-masing lalu isi key BARU di bawah ini.
# =========================================================

# MongoDB connection string (opsional, kosongkan untuk pakai session lokal)
MONGODB_URL=

# Groq AI API Key (https://console.groq.com)
GROQ_API_KEY=***REMOVED***

# API Keys eksternal
NAZE_API_KEY=***REMOVED***
NEOSANTARA_API_KEY=***REMOVED***

# Admin key untuk dashboard remote (lib/server.js). WAJIB diisi manual
# dengan string acak yang panjang jika DASHBOARD_ENABLED=true.
ADMIN_KEY=

# Dashboard remote (menghubungkan bot ke relay server pihak ketiga
# bot.naze.biz.id dan mengekspos endpoint exec_terminal / eksekusi
# perintah shell). Default OFF. Baca catatan keamanan di README
# sebelum mengaktifkan ini.
DASHBOARD_ENABLED=false

# Wajib true secara terpisah agar endpoint exec_terminal (eksekusi shell
# jarak jauh) aktif, walau DASHBOARD_ENABLED=true. Default OFF.
ALLOW_REMOTE_EXEC=false

# Set true hanya jika API pihak ketiga yang kamu pakai memang punya
# sertifikat TLS invalid/self-signed dan kamu paham risikonya (rentan MITM).
ALLOW_INSECURE_TLS=false
